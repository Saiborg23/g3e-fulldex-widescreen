diff --git a/gba/frontend/main.cpp b/gba/frontend/main.cpp
index f1750f8..4fda9d4 100755
--- a/gba/frontend/main.cpp
+++ b/gba/frontend/main.cpp
@@ -3146,6 +3146,23 @@ struct App
                 l.done = 2;
                 shotTaken = true;
             }
+            else if (l.what == "dump" && l.done == 0 && now >= l.frame && core && core->board)
+            {
+                // (test build) "dump FRAME FILE": EWRAM 256K, IWRAM 32K, VRAM 96K, OAM 1K, palette 1K, IO 1K
+                auto* g = (struct GBA*)core->board;
+                if (FILE* f = fopen(l.arg.c_str(), "wb"))
+                {
+                    fwrite(g->memory.wram, 1, 0x40000, f);
+                    fwrite(g->memory.iwram, 1, 0x8000, f);
+                    fwrite(g->video.vram, 1, 0x18000, f);
+                    fwrite(g->video.oam.raw, 1, 0x400, f);
+                    fwrite(g->video.palette, 1, 0x400, f);
+                    fwrite(g->memory.io, 1, 0x400, f);
+                    fclose(f);
+                    printf("dump %lld %s\n", now, l.arg.c_str());
+                }
+                l.done = 2;
+            }
     }
 
